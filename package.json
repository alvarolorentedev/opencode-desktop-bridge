{
  "name": "@alvarolorentedev/opencode-desktop-bridge",
  "version": "0.1.0",
  "description": "One virtual OpenCode server for every server configured in OpenCode Desktop, the TUI or the web.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvarolorentedev/opencode-desktop-bridge.git"
  },
  "files": [
    "dist",
    "docs",
    "src/tui.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./tui": "./src/tui.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/",
    "check": "node scripts/build.mjs && node --test test/",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  }
}
